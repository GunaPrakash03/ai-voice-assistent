# Copy to .env and fill in. Never commit .env.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# Task 1.2+ — not needed for 1.1
DEEPGRAM_API_KEY=
# Hearing the caller: gemini = the Gemini model transcribes the audio itself (no speech-to-text vendor);
# deepgram = Deepgram Nova streaming. Deepgram is otherwise used only for the Aura voice.
STT_PROVIDER=gemini
STT_MODEL=nova-3
CARTESIA_API_KEY=
OPENAI_API_KEY=

# Retell AI platform voice library (Agent Builder → Retell AI tab). Retell has no TTS endpoint;
# custom text is synthesized via the voice's underlying engine key (ELEVEN_API_KEY / OPENAI_API_KEY / DEEPGRAM_API_KEY).

# ── Durable storage (PostgreSQL in docker-compose) ──────────────────────────
# The dashboard (scripts/serve.py, on the host) talks to the compose Postgres on 127.0.0.1:5433;
# the worker container uses the same DB as postgres:5432. Leave DATABASE_URL empty to run on
# JSON files + the recordings folder only.
VOICE_DB_NAME=voice_agent
VOICE_DB_USER=voice
VOICE_DB_PASSWORD=voice_dev_password
DATABASE_URL=postgresql://voice:voice_dev_password@127.0.0.1:5433/voice_agent
