# Copy to .env and fill in. Never commit .env.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# Task 1.2+ — not needed for 1.1
DEEPGRAM_API_KEY=
# Hearing the caller: deepgram = Deepgram Nova streaming (default; Retell-style, ~1.5 s faster per turn);
# gemini = the Gemini model hears the audio itself (no speech-to-text vendor, +$0.0045/min saved).
STT_PROVIDER=deepgram
STT_MODEL=nova-3
CARTESIA_API_KEY=
OPENAI_API_KEY=

# ── Extra TTS voice providers (Agent Builder → Select Voice) ─────────────────
# Each lights up its own tab in the voice picker once its key is set; until then those
# voices still list but mark themselves "needs key". Gemini TTS reuses GEMINI_API_KEY below.
INWORLD_API_KEY=
# MiniMax: the API key is required. MINIMAX_GROUP_ID is optional — newer sk-api keys bind the
# group to the token, so leave it blank (do NOT paste your UID; a wrong group id fails auth).
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
FISH_AUDIO_API_KEY=
# Optional model overrides (sensible defaults are used when blank):
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# INWORLD_TTS_MODEL=inworld-tts-2  (options: inworld-tts-1, inworld-tts-1-max, inworld-tts-1.5-max, inworld-tts-2)
# MINIMAX_TTS_MODEL=speech-02-turbo
# FISH_TTS_MODEL=s1

# ── Inbound phone calls (Twilio) ────────────────────────────────────────────
# The public URL Twilio can reach this dashboard on. When set, every number bought or imported on
# the Call Desk has its Twilio Voice webhook pointed at <PUBLIC_BASE_URL>/api/telephony/voice/inbound
# automatically (Retell-style: nothing to paste into the Twilio console). Railway sets
# RAILWAY_PUBLIC_DOMAIN, which is used when this is empty. Local dev: your ngrok https URL.
PUBLIC_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# media_stream (default, Twilio <Connect><Stream> straight into agent/twilio_stream.py) or sip (LiveKit Cloud SIP)
TWILIO_CONNECTION_MODE=media_stream
# Inbound webhooks are rejected unless X-Twilio-Signature verifies against TWILIO_AUTH_TOKEN. Set to 0
# only if a proxy rewrites the URL Twilio signed.
TWILIO_VALIDATE_SIGNATURE=1

# Retell AI platform voice library (Agent Builder → Retell AI tab). Retell has no TTS endpoint;
# custom text is synthesized via the voice's underlying engine key (ELEVEN_API_KEY / OPENAI_API_KEY / DEEPGRAM_API_KEY).

# ── Durable storage (PostgreSQL in docker-compose) ──────────────────────────
# The dashboard (scripts/serve.py, on the host) talks to the compose Postgres on 127.0.0.1:5433;
# the worker container uses the same DB as postgres:5432. Leave DATABASE_URL empty to run on
# JSON files + the recordings folder only.
VOICE_DB_NAME=voice_agent
VOICE_DB_USER=voice
VOICE_DB_PASSWORD=voice_dev_password
DATABASE_URL=postgresql://voice:voice_dev_password@127.0.0.1:5433/voice_agent

# ── Owner account ───────────────────────────────────────────────────────────
# Email(s) that must exist as active Super Admins at startup (created in the default workspace if
# missing, promoted if present). SUPER_ADMIN_PASSWORD sets the first password only when the account
# has none yet; change it from the profile page afterwards.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
# One-shot: set to 1 to overwrite the account's existing password with SUPER_ADMIN_PASSWORD, then unset.
SUPER_ADMIN_RESET_PASSWORD=

# ── Email (forgot-password links) ───────────────────────────────────────────
# Either a Resend API key (https://resend.com, works from Railway without SMTP ports) …
RESEND_API_KEY=
# … or plain SMTP (587 = STARTTLS, 465 = TLS). Gmail/Workspace: smtp.gmail.com + an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to the recipient; must be a verified domain/address on the transport you use.
MAIL_FROM=Voice Agent <no-reply@yourdomain.com>
